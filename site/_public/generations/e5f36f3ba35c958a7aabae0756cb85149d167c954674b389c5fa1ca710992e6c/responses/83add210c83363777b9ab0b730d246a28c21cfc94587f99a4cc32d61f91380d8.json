{"schemaVersion":"public-read-v0.1","items":[{"publicId":"public-rss-2252024ead6ae7bbb3e60f62048b5b9a001be98ea63e4524bae308ac9b920afd","contentType":"race_news","state":"media_missing","titleZh":"奥利弗·贝尔曼透露F1之外的新商业冒险：开设自行车店与咖啡馆","summaryZh":"哈斯F1车手奥利弗·贝尔曼透露，他与一群朋友在摩纳哥上方开设了一家自行车店和咖啡馆。这位21岁的英国人在F1 Beyond The Grid播客中谈到了他对骑行日益增长的热情。他将这项运动大量融入2026年F1赛季的训练中，现在又将这一兴趣转化为商业投资。","publishedAt":"2026-08-13T15:58:56.632Z","sourcePublishedAt":"2026-08-09T10:12:42.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":null,"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/oliver-bearman-reveals-new-business-venture-away-from-f1/10845198/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-32dbd54f47520716ee8c0301c0d135708d5f2b558b858e01943db31719592ab3","contentType":"race_news","state":"media_missing","titleZh":"博尔托莱托反驳F1 2026赛车与驾驶风格冲突的观点","summaryZh":"加布里埃尔·博尔托莱托强烈主张，F1车手“应该能够适应”任何赛车，反驳了2026年赛车与驾驶风格相冲突的观点。今年转向了更多电动化机械，电动与内燃机动力分配为47-53，导致比赛风格不同，电池管理成为关键。","publishedAt":"2026-08-14T10:25:37.366Z","sourcePublishedAt":"2026-08-09T08:06:56.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":null,"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/gabriel-bortoleto-refutes-idea-of-f1-2026-cars-clashing-with-driving-styles/10844776/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-4fe323914f4cf4269cc553d55a41374cc7a0ae63a87be65fbf149096c394ef0c","contentType":"race_news","state":"media_missing","titleZh":"汉密尔顿分享与新宠物狗Halo的首批照片","summaryZh":"七届F1世界冠军刘易斯·汉密尔顿分享了与家中新成员——一只名为Halo的金毛寻回犬幼犬的首批照片。在2026赛季前半段，汉密尔顿在巴塞罗那-加泰罗尼亚大奖赛上为法拉利车队赢得个人首个分站冠军，并多次登上领奖台。如今，他正利用休赛期与新伙伴一起休息充电。","publishedAt":"2026-08-14T10:25:37.366Z","sourcePublishedAt":"2026-08-08T14:27:07.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":null,"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/lewis-hamilton-shares-first-photos-with-new-puppy-halo/10845015/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-7ce51b4f8122962c02063c982a47baeeeb8ec5b9d8557e0e315f2f473f9b0deb","contentType":"race_news","state":"media_missing","titleZh":"哈贾尔谈红牛“文化冲击”：从Racing Bulls到红牛队","summaryZh":"伊萨克·哈贾尔表示，从Racing Bulls晋升到红牛一队是一次“文化冲击”，但这位21岁的车手坚称，他在青训项目中的多年经历让这次过渡感觉自然。哈贾尔在Racing Bulls度过新秀赛季后，于2026赛季晋升至红牛，与四届F1世界冠军马克斯·维斯塔潘搭档。尽管两支车队同属红牛体系，但哈贾尔仍感受到了差异。","publishedAt":"2026-08-14T10:25:37.366Z","sourcePublishedAt":"2026-08-08T13:47:53.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":null,"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/isack-hadjar-explains-red-bull-culture-shock-after-racing-bulls-move/10845005/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-f5841e089893f296e9850020b8352fac9b56f43d6c56129b7d2a91942be442e6","contentType":"race_news","state":"ready","titleZh":"FIA计划在下一轮规则改革中让F1赛车再减重80公斤","summaryZh":"在2026年F1规则引入时，FIA多次提及所谓的“灵活赛车概念”，旨在让赛车更小更轻，但变化相对有限。今年轴距缩短20厘米，宽度减少10厘米，最低重量设定为768公斤，减轻了32公斤。FIA希望在下一轮规则改革中再减重80公斤。","publishedAt":"2026-08-19T10:07:42.440Z","sourcePublishedAt":"2026-08-07T14:51:24.000Z","sourceTimeStatus":"known","source":{"sourceId":"autosport-f1-news","platform":"rss","displayName":"Autosport","byline":"Autosport","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-3.motorsport.com/images/amp/0qgPmDOY/s6/oscar-piastri-mclaren-george-r-5.jpg","mimeType":"image/jpeg","declaredBytes":367251,"altZh":"FIA计划在下一轮规则改革中让F1赛车再减重80公斤"},"originalLink":{"enabled":true,"url":"https://www.autosport.com/f1/news/fia-wants-f1-cars-to-lose-another-80-kilos/10844769/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=uk","reason":null}},{"publicId":"public-rss-28b02d1cde86f2d2687b041257f8a8f46a67f48b489fcbb04a610463c410716f","contentType":"race_news","state":"ready","titleZh":"克拉克、塞纳、安东内利——大满贯年龄纪录的演变","summaryZh":"F1大满贯（杆位、领跑每一圈并夺冠、同时创造最快圈速）的年龄纪录不断被刷新。胡安·曼努埃尔·方吉奥在1950年摩纳哥大奖赛上以38岁10个月27天的年龄成为首位大满贯得主，当时他在排位赛中领先2.6秒，并全程领跑。此后，吉姆·克拉克、埃尔顿·塞纳等车手相继打破纪录，而最近，安德烈亚·安东内利可能再次刷新这一纪录。","publishedAt":"2026-08-19T09:36:42.426Z","sourcePublishedAt":"2026-08-07T08:20:17.000Z","sourceTimeStatus":"known","source":{"sourceId":"autosport-f1-news","platform":"rss","displayName":"Autosport","byline":"Autosport","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-9.motorsport.com/images/amp/6AlvRNGY/s6/juan-manuel-fangio-alfa-romeo.jpg","mimeType":"image/jpeg","declaredBytes":423874,"altZh":"克拉克、塞纳、安东内利——大满贯年龄纪录的演变"},"originalLink":{"enabled":true,"url":"https://www.autosport.com/f1/news/clark-senna-antonelli-grand-chelem-youngest-record-evolution/10844336/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=uk","reason":null}},{"publicId":"public-rss-d058090e372019bcbb7156e60a90910a5799f3e46cf53ce52e4bdb02d26df820","contentType":"race_news","state":"ready","titleZh":"威廉姆斯模拟器车手维克多·马丁斯谈角色：对赛车有间接影响","summaryZh":"威廉姆斯F1车队模拟器车手维克多·马丁斯在接受Autosport采访时表示，他对赛车有影响，但并非直接，因为团队中有许多人、许多部门需要改进和分析。不过，他确实参与赛车开发工作。","publishedAt":"2026-08-19T07:07:46.903Z","sourcePublishedAt":"2026-08-06T14:44:52.000Z","sourceTimeStatus":"known","source":{"sourceId":"autosport-f1-news","platform":"rs