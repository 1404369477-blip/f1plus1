-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-1.motorsport.com/images/amp/68VWZKG2/s6/lewis-hamilton-ferrari-max-ver.jpg","mimeType":"image/jpeg","declaredBytes":285280,"altZh":"2026赛季至今最佳驾驶：我们的编辑评选"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/sun-the-best-drives-of-the-2026-f1-season-so-far-according-to-our-writers/10846338/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null},"relatedSources":[{"publicId":"public-rss-7eba4ff1711b27a299662e86e9a7d8ac766055df0938a873f1ceeb6fa4d478f3","sourceId":"autosport-f1-news","displayName":"Autosport","originalUrl":"https://www.autosport.com/f1/news/the-best-drives-of-the-2026-f1-season-so-far-according-to-our-writers/10846635/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=uk"}]},{"publicId":"public-rss-dc64bda1f730c58b2447a467dafa58d7dae882bb0707a89af5809a3e499c6a32","contentType":"race_news","state":"ready","titleZh":"投票：F1是否在黄旗下允许车手刷新排位赛成绩上冒险过大？","summaryZh":"F1正在考虑是否允许车手在黄旗状态下继续提升排位赛圈速，这一做法引发争议。本投票旨在收集车迷意见，探讨该规则是否过度冒险。","publishedAt":"2026-08-20T05:32:55.255Z","sourcePublishedAt":"2026-08-16T07:34:36.000Z","sourceTimeStatus":"known","source":{"sourceId":"racefans-f1-news","platform":"rss","displayName":"RaceFans","byline":"Keith Collantine","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://www.racefans.net/wp-content/uploads/2026/06/M607096_F1_Grand_Prix_of_Austria_Practice.jpg","mimeType":"image/jpeg","declaredBytes":1,"altZh":"投票：F1是否在黄旗下允许车手刷新排位赛成绩上冒险过大？"},"originalLink":{"enabled":true,"url":"https://www.racefans.net/2026/08/16/poll-is-formula-1-risking-too-much-by-letting-drivers-set-qualifying-times-under-yellow-flags/","reason":null}},{"publicId":"public-rss-53c5d5533bd98248adb6c80bf318676d3a995037cc925b708e24dd44ce99bc49","con