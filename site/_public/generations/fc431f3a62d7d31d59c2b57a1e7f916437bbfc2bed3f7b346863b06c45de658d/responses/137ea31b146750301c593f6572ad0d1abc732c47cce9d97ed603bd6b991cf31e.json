47334/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-c0cf439d6f9535e7901808c43282b1b03dceacb1c90289a0032d5685ac0c3756","contentType":"race_news","state":"ready","titleZh":"库特哈德预测赞德福特将永久告别F1赛历","summaryZh":"前F1车手大卫·库特哈德认为，赞德福特赛道将永远不会重返F1赛历，理由是赛道面临严重的物理和商业限制。该滨海赛道本周末将举办其最后的F1荷兰大奖赛。赞德福特在缺席35年后于2021年成功重返赛历，但如今即将告别。","publishedAt":"2026-08-20T06:32:55.919Z","sourcePublishedAt":"2026-08-19T12:25:03.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-6.motorsport.com/images/amp/2y3e5496/s6/aerial-photograph-of-the-circu.jpg","mimeType":"image/jpeg","declaredBytes":449802,"altZh":"库特哈德预测赞德福特将永久告别F1赛历"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/david-coulthard-predicts-zandvoort-will-never-return-to-f1-calendar/10847326/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-147187fdaaa00f0d9844897fbdc81385c8c5295aa658fd05f35b92adbd004f93","contentType":"race_news","state":"ready","titleZh":"FIA确定迈凯伦与红牛摩纳哥大奖赛上诉听证日期","summaryZh":"国际汽联（FIA）将于下周审理迈凯伦和红牛针对摩纳哥大奖赛恢复皮埃尔·加斯利领奖台位置决定的上诉。6月7日，Alpine车手加斯利以第三名完赛，但因两次维修区超速被罚时5秒，最终跌至第七，红牛的伊萨克·哈贾尔因此获得领奖台。Alpine车队随即提出复审请求。","publishedAt":"2026-08-19T18:14:44.231Z","sourcePublishedAt":"2026-08-19T11:55:46.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-6.motorsport.com/images/amp/27NQP8X0/s6/lando-norris-mclaren-pierre-ga.jpg","mimeType":"image/jpeg","declaredBytes":544440,"altZh":"FIA确定迈凯伦与红牛摩纳哥大奖赛上诉听证日期"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/fia-sets-date-for-mclaren-and-red-bulls-monaco-gp-appeal/10847318/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-d5bbe8727fb54bd92e8fe4a824ff0261c7f857eddd33902b31fd96d376a11716","contentType":"race_news","state":"ready","titleZh":"伊萨克·哈贾尔因伤缺席F1荷兰大奖赛，红牛确认劳森替补","summaryZh":"红牛车队已正式确认，利亚姆·劳森将在本周末的F1荷兰大奖赛中替补受伤的伊萨克·哈贾尔。周三上午有消息称，哈贾尔在健身房训练时手腕受伤，因此将缺席赞德福特站的比赛，红牛随即做出正式决定。这意味着哈贾尔无法在目前唯一给他带来过好成绩的赛道上参赛。","publishedAt":"2026-08-20T15:11:57.699Z","sourcePublishedAt":"2026-08-19T11:05:48.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-5.motorsport.com/images/amp/6zoJ59L0/s6/isack-hadjar-red-bull-racing.jpg","mimeType":"image/jpeg","declaredBytes":212798,"altZh":"伊萨克·哈贾尔因伤缺席F1荷兰大奖赛，红牛确认劳森替补"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/isack-hadjar-to-miss-f1-dutch-gp-red-bulls-replacement-confirmed/10847292/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-b98992864e2e157c74095ec53138a60b258c611321f06f7bab38703a44c2c316","contentType":"race_news","state":"ready","titleZh":"F1车手如何度过2026年夏休期","summaryZh":"F1的强制夏休期让围场在荷兰大奖赛前得到了宝贵的充电机会。随着车手们重返工作岗位，备战赞德沃特赛道，他们分享了各自在假期中的活动。文章介绍了车手们在夏休期间的生活点滴。","publishedAt":"2026-08-20T06:47:56.095Z","sourcePublishedAt":"2026-08-19T10:24:09.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-4.motorsport.com/images/amp/0kZAOqK6/s6/race-start.jpg","mimeType":"image/jpeg","declaredBytes":373552,"altZh":"F1车手如何度过2026年夏休期"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/how-f1-drivers-spent-the-2026-summer-beak/10847288/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-185e179976218f76452ce9ec24d8f42c11bfd85e7e650d7e0e21cccfe25726fe","contentType":"race_news","state":"ready","titleZh":"F1发车程序保持不变，尽管FIA称其不再是安全问题","summaryZh":"在巴林冬季测试期间，练习赛起步程序引发争议，并迅速在围场内掀起政治辩论。许多车队希望在起步过程中有更多时间让涡轮增压器加速并提升转速，但法拉利对此并不热衷，因为其较小的涡轮在起步时具有竞争优势。尽管FIA表示该程序不再是安全问题，但F1的发车程序仍将保持不变。","publishedAt":"2026-08-19T15:42:43.107Z","sourcePublishedAt":"2026-08-19T09:34:03.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-7.motorsport.com/images/amp/Y9lLZPb2/s6/start-grid.jpg","mimeType":"image/jpeg","declaredBytes":234752,"altZh":"F1发车程序保持不变，尽管FIA称其不再是安全问题"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/f1-pre-start-procedure-to-stay-despite-fia-saying-it-is-no-longer-a-safety-issue/10847147/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-cf9c6158f1e95fd3376eedeed6c87af808c550cf0c88cc6cee64474f6fe583c1","contentType":"race_news","state":"ready","titleZh":"前F1主持人：没有格雷姆·洛登，凯迪拉克不会出现在发车格上","summaryZh":"前F1广播员威尔·巴克斯顿称赞格雷姆·洛登，称凯迪拉克车队若没有他，就不会出现在今天的发车格上。凯迪拉克在夏休期间宣布，洛登在担任车队负责人的首个赛季仅11场比赛后就被替换，接替他的是前雷诺执行董事和FIA技术官员。","publishedAt":"2026-08-19T15:12:43.075Z","sourcePublishedAt":"2026-08-19T09:02:15.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-8.motorsport.com/images/amp/68VWODG2/s6/graeme-lowdon-team-principal-o.jpg","mimeType":"image/jpeg","declaredBytes":199697,"altZh":"前F1主持人：没有格雷姆·洛登，凯迪拉克不会出现在发车格上"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/cadillac-wouldnt-be-on-the-grid-without-graeme-lowdon-says-former-f1-tv-host/10847263/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-dbb488bff50072589f1542b6db060617c40ecc1463f8e3511bc7c5e775139e5a","contentType":"race_news","state":"ready","titleZh":"伊萨克·哈贾尔或因手腕伤势缺席F1荷兰大奖赛，红牛已有替补计划","summaryZh":"据Motorsport.com报道，红牛二队车手伊萨克·哈贾尔在赞德沃特赛前的一次健身房训练中手腕受伤，可能被迫缺席荷兰大奖赛。车队尚未做出正式决定，但红牛已有替补计划，马克斯·维斯塔潘可能迎来不同的队友参加他的主场收官战。","publishedAt":"2026-08-19T18:29:44.194Z","sourcePublishedAt":"2026-08-19T07:48:49.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-1.motorsport.com/images/amp/25dLeVx0/s6/isack-hadjar-red-bull-racing.jpg","mimeType":"image/jpeg","declaredBytes":182626,"altZh":"伊萨克·哈贾尔或因手腕伤势缺席F1荷兰大奖赛，红牛已有替补计划"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/isack-hadjar-could-miss-f1-dutch-gp-with-red-bull-replacement-plan-already-in-place/10847237/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-e704ffd04a608605f92f8b18a49f58b31f92d11d7373e8a07ed2855d966b7075","contentType":"race_news","state":"ready","titleZh":"“不是朝九晚五的巡航”——从零组建凯迪拉克赛道团队的回报性挑战","summaryZh":"凯迪拉克在加入2026年F1赛程前一年开始寻找车队经理，很快锁定了哈斯车队长期任职的车队经理彼得·克罗拉。克罗拉寻求新挑战，并期待再次从零组建团队的机会。","publishedAt":"2026-08-19T09:52:42.447Z","sourcePublishedAt":"2026-08-18T15:16:30.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-6.motorsport.com/images/amp/0JXwGbMY/s6/valtteri-bottas-cadilla