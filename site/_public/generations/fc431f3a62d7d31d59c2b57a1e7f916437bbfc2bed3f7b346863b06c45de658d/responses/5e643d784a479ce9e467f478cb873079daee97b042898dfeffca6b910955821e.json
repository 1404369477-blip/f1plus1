{"schemaVersion":"public-read-v0.1","items":[{"publicId":"public-rss-4d522aacb0fb94cd7840fe2384dc9f8c0c519ed92ccdb07ede61b6bc9e967b25","contentType":"race_news","state":"ready","titleZh":"斯泰纳为重返F1设定条件","summaryZh":"前哈斯车队领队冈瑟·斯泰纳表示，如果机会是一个真正的“项目”，他愿意重返F1。斯泰纳因Netflix纪录片《极速求生》成为车迷喜爱的人物，于2024年1月被哈斯车队替换。自离开后，这位61岁的老人成为The Red...的常客。","publishedAt":"2026-08-19T00:14:17.750Z","sourcePublishedAt":"2026-08-13T13:15:18.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-3.motorsport.com/images/amp/YvKQRg16/s6/guenther-steiner.jpg","mimeType":"image/jpeg","declaredBytes":188526,"altZh":"斯泰纳为重返F1设定条件"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/guenther-steiner-sets-condition-for-potential-f1-return/10846138/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-84a14bf14b92ddec3ae0e6f41d4337c420859613637fb8c6f4f3a70bc81352ed","contentType":"race_news","state":"ready","titleZh":"伊萨克·哈贾尔指出与维斯塔潘相比需提升的关键领域","summaryZh":"2026赛季过半，关于红牛车手席位的讨论仍在继续，但焦点已不再是近年来压力最大的位置。这或许是对伊萨克·哈贾尔晋升红牛的最大肯定。自丹尼尔·里卡多转投雷诺以来，皮埃尔·加斯利、亚历山大·阿尔本、塞尔吉奥·佩雷斯、利亚姆·劳森和角田裕毅都曾经历这一席位的考验。哈贾尔现在正努力在红牛站稳脚跟，并明确指出了自己相比马克斯·维斯塔潘需要改进的关键领域。","publishedAt":"2026-08-19T00:14:17.750Z","sourcePublishedAt":"2026-08-13T13:00:03.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-4.motorsport.com/images/amp/25dLe7D0/s6/isack-hadjar-red-bull-racing.jpg","mimeType":"image/jpeg","declaredBytes":277239,"altZh":"伊萨克·哈贾尔指出与维斯塔潘相比需提升的关键领域"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/isack-hadjar-identifies-key-area-he-must-improve-compared-to-max-verstappen/10846118/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-89992b9b751d5b276f726f6d3aa4d567dbce383246223d5f55f76201072b26df","contentType":"race_news","state":"ready","titleZh":"勒克莱尔与妻子度假照片疑似回应怀孕传闻","summaryZh":"法拉利F1车手夏尔·勒克莱尔与妻子亚历山德拉今年早些时候在摩纳哥举行私人婚礼，目前正在撒丁岛度假。近日，他们豪华游艇度假的照片引发外界猜测，亚历山德拉似乎有孕在身。尽管两人尚未正式宣布，但照片似乎回应了怀孕传闻。","publishedAt":"2026-08-19T00:14:17.750Z","sourcePublishedAt":"2026-08-13T12:15:47.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-1.motorsport.com/images/amp/0oOy3w10/s6/charles-leclerc-ferrari-with-h.jpg","mimeType":"image/jpeg","declaredBytes":248089,"altZh":"勒克莱尔与妻子度假照片疑似回应怀孕传闻"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/charles-leclerc-and-wife-alexandra-appear-to-address-pregnancy-rumours-with-holiday-photos/10846116/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-855a747adc13287c7aa047afa1342abca651aa12fb5248d26558fd0401c2757a","contentType":"race_news","state":"ready","titleZh":"博塔斯：凯迪拉克首个F1赛季虽艰难但进步明显","summaryZh":"凯迪拉克F1车队车手瓦尔特里·博塔斯表示，在车队首个F1赛季的上半段，已经看到了新组建车队的进步。凯迪拉克于2026年作为第11支车队加入F1，拥有经验丰富的车手阵容，包括前梅赛德斯车手博塔斯和前红牛车手塞尔吉奥·佩雷斯。尽管车队尚未获得积分，且遭遇可靠性问题，但博塔斯认为进步是清晰的。","publishedAt":"2026-08-19T00:14:17.750Z","sourcePublishedAt":"2026-08-13T11:19:30.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-7.motorsport.com/images/amp/0qgKP18Y/s6/valtteri-bottas-cadillac.jpg","mimeType":"image/jpeg","declaredBytes":127460,"altZh":"博塔斯：凯迪拉克首个F1赛季虽艰难但进步明显"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/valtteri-bottas-sees-clear-cadillac-progress-amid-challenging-first-f1-season/10846099/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-8c891c1436d3af41c2b27bddcfaffcae36b475dc7194c12c71fbfccacc53d2f9","contentType":"race_news","state":"ready","titleZh":"F1 2026赛季中期评分：红牛开局不利但夏季反弹显进步","summaryZh":"红牛作为正式动力单元制造商的开端令人钦佩，但在底盘方面，车队自赛季初便落后于主要竞争对手。赛季末的冲刺将评分从不及格拉回C-。红牛在墨尔本站以第四快车队身份开局，初期劣势多归因于动力单元，但底盘问题同样存在。","publishedAt":"2026-08-19T00:14:17.750Z","sourcePublishedAt":"2026-08-13T11:01:52.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-2.motorsport.com/images/amp/0mXyPv46/s6/team-report-card-red-bull.jpg","mimeType":"image/jpeg","declaredBytes":351194,"altZh":"F1 2026赛季中期评分：红牛开局不利但夏季反弹显进步"},"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/f1-2026-mid-season-grades-red-bull-stumbles-but-summer-rally-shows-glimmer-of-progress/10845430/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}},{"publicId":"public-rss-e7beb762e9bfb7a1e704439e47817a32f366932933e4bf91770d57206c28d702","contentType":"race_news","state":"ready","titleZh":"罗伯·斯梅德利质疑哈斯成为F1领先车队的前景","summaryZh":"前法拉利F1比赛工程师罗伯·斯梅德利认为，哈斯车队的结构将阻碍其成为锦标赛中的领先车队。哈斯于2016年加入F1，严重依赖与法拉利的技术合作。虽然这种方式让哈斯以更具成本效益的方式进入锦标赛，但常常导致赛季中期表现下滑。","publishedAt":"2026-08-19T00:14:17.750Z","sourcePublishedAt":"2026-08-13T10:53:01.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":{"kind":"source_image","assetRef":"https://cdn-7.motorsport.com/images/amp/0R7wmkZ2/s6/oliver-bearman-haas-f1-team-es.jpg","mimeType":