{"schemaVersion":"public-read-v0.1","items":[{"publicId":"public-rss-7ce51b4f8122962c02063c982a47baeeeb8ec5b9d8557e0e315f2f473f9b0deb","contentType":"race_news","state":"media_missing","titleZh":"哈贾尔谈红牛“文化冲击”：从Racing Bulls到红牛队","summaryZh":"伊萨克·哈贾尔表示，从Racing Bulls晋升到红牛一队是一次“文化冲击”，但这位21岁的车手坚称，他在青训项目中的多年经历让这次过渡感觉自然。哈贾尔在Racing Bulls度过新秀赛季后，于2026赛季晋升至红牛，与四届F1世界冠军马克斯·维斯塔潘搭档。尽管两支车队同属红牛体系，但哈贾尔仍感受到了差异。","publishedAt":"2026-08-14T10:25:37.366Z","sourcePublishedAt":"2026-08-08T13:47:53.000Z","sourceTimeStatus":"known","source":{"sourceId":"motorsport-f1-news","platform":"rss","displayName":"Motorsport.com","byline":"Motorsport.com","accessStatus":"available"},"media":null,"originalLink":{"enabled":true,"url":"https://www.motorsport.com/f1/news/isack-hadjar-explains-red-bull-culture-shock-after-racing-bulls-move/10845005/?utm_source=RSS&amp;utm_medium=referral&amp;utm_campaign=RSS-F1&amp;utm_term=News&amp;utm_content=www","reason":null}}],"page":{"pageSize":12,"hasMore":false,"nextCursor":null}}